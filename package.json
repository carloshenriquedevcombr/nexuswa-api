{
  "name": "nexuswa-api",
  "version": "2.0.0",
  "description": "NexusWA — API multi-instância de automação WhatsApp (Baileys) com paridade de rotas uazapi 2.4.2, multi-tenant e Secure-by-Design",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests",
    "test": "node --import tsx --test --test-reporter=spec tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "user:create": "tsx --env-file=.env src/cli/createUser.ts",
    "user:create:prod": "node dist/cli/createUser.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "prisma": "5.22.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.5",
    "socks-proxy-agent": "^10.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0"
  }
}
