# =====================================================================
# NexusWA — variáveis de ambiente
# Gere os segredos com:  npm run secrets:generate   (ou: node scripts/generate-secrets.mjs)
# NUNCA versione o arquivo .env real.
# =====================================================================

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
# URL pública da API (usada em links de arquivos e no campo BaseUrl dos webhooks)
PUBLIC_URL=http://localhost:3000
# Origens do seu dashboard autorizadas a chamar a API pelo navegador (separe por vírgula)
CORS_ORIGINS=http://localhost:3001
# Quantos proxies reversos existem na frente da API (Nginx Proxy Manager = 1; + Cloudflare = 2)
TRUST_PROXY=1
# false apenas em http://localhost; em produção (HTTPS) SEMPRE true
COOKIE_SECURE=false

# ---------- Banco e Redis (docker-compose) ----------
POSTGRES_DB=nexuswa
POSTGRES_USER=nexuswa
POSTGRES_PASSWORD=TROQUE_PELO_GERADO
REDIS_PASSWORD=TROQUE_PELO_GERADO
# Usado apenas quando a API roda FORA do Docker (npm run dev). Portas do docker-compose.pc.yml:
DATABASE_URL=postgresql://nexuswa:TROQUE_PELO_GERADO@localhost:5433/nexuswa?schema=public
REDIS_URL=redis://:TROQUE_PELO_GERADO@localhost:6380

# ---------- Segredos (obrigatórios) ----------
ADMIN_TOKEN=TROQUE_PELO_GERADO
JWT_SECRET=TROQUE_PELO_GERADO
ENCRYPTION_KEY=TROQUE_PELO_GERADO
METRICS_TOKEN=TROQUE_PELO_GERADO

# ---------- Sessão de usuário ----------
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- Mídia / retenção ----------
MEDIA_MAX_MB=64
FILE_URL_TTL_HOURS=48
# Fuso dos horários de almoço dos atendentes
APP_TIMEZONE=America/Sao_Paulo
# Anexos do painel (arrastar e soltar): validade em dias e cota por instância (MB)
UPLOAD_TTL_DAYS=30
UPLOAD_QUOTA_MB=2048
MESSAGE_RETENTION_DAYS=7
UNPAIRED_INSTANCE_TTL_MIN=60

# ---------- Rede ----------
# Hosts internos liberados SOMENTE como destino de webhook (ex.: n8n na mesma rede Docker)
WEBHOOK_INTERNAL_HOSTS=n8n
# Nunca ative em produção: desliga a proteção SSRF para redes internas
SSRF_ALLOW_PRIVATE=false

# ---------- Opcional ----------
# Chave OpenAI padrão para transcrição de áudio (pode ser definida por instância)
OPENAI_API_KEY=
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
RATE_LIMIT_GLOBAL_PER_MIN=600
RATE_LIMIT_SEND_PER_MIN=120

# ---------- VPS ----------
# Rede Docker do Nginx Proxy Manager (confira com: docker network ls)
PROXY_NETWORK=docker-base_default
